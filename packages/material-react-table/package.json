{
  "version": "4.0.4",
  "license": "MIT",
  "name": "@cutting/material-react-table",
  "description": "Maintenance fork of material-react-table updated for Material UI v9. A fully featured Material UI implementation of TanStack React Table V8.",
  "author": "Paul Cowan <paul.cowan@cutting.scot>",
  "contributors": [
    {
      "name": "Kevin Vandy",
      "url": "https://github.com/KevinVandy"
    }
  ],
  "keywords": [
    "react-table",
    "material-ui",
    "material-table",
    "tanstack table",
    "data table"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dagda1/material-react-table"
  },
  "homepage": "https://github.com/dagda1/material-react-table#readme",
  "bugs": {
    "url": "https://github.com/dagda1/material-react-table/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "locales",
    "src"
  ],
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "56 KB"
    },
    {
      "path": "dist/index.esm.js",
      "limit": "53 KB"
    }
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm lib:build",
    "build-locales": "pnpm lib:build-locales",
    "build-lib": "pnpm lib:build-lib",
    "dev": "pnpm lib:dev",
    "lib:build": "pnpm build-lib && pnpm build-locales",
    "lib:build-locales": "node build-locales.mjs",
    "lib:build-lib": "rm -rf dist && rollup -c rollup.config.mjs && size-limit",
    "lib:dev": "rollup -c rollup.config.mjs --watch",
    "lint": "eslint .",
    "size": "size-limit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm lib:build && pnpm test",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:dev": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.4.0",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@mui/x-date-pickers": "^9.3.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-links": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-react": "^6.0.2",
    "dayjs": "^1.11.20",
    "eslint": "^10.4.0",
    "eslint-plugin-mui-path-imports": "^0.0.15",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-storybook": "^10.4.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-is": "^19.2.6",
    "rollup": "^4.60.4",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-delete": "^3.0.2",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "size-limit": "^12.1.0",
    "storybook": "^10.4.0",
    "storybook-dark-mode": "^5.0.0",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "@emotion/react": ">=11.13",
    "@emotion/styled": ">=11.13",
    "@mui/icons-material": ">=9",
    "@mui/material": ">=9",
    "@mui/x-date-pickers": ">=9.2",
    "react": ">=19.0",
    "react-dom": ">=19.0"
  },
  "dependencies": {
    "@tanstack/match-sorter-utils": "8.19.4",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.13.25",
    "highlight-words": "2.0.0"
  }
}
