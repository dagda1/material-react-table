{
  "version": "5.0.0",
  "license": "MIT",
  "name": "@cutting/material-react-table",
  "description": "Maintenance fork of material-react-table updated for Material UI v9. A fully featured Material UI implementation of TanStack React Table V8.",
  "author": "Paul Cowan <paul.cowan@cutting.scot>",
  "contributors": [
    {
      "name": "Kevin Vandy",
      "url": "https://github.com/KevinVandy"
    }
  ],
  "keywords": [
    "react-table",
    "material-ui",
    "material-table",
    "tanstack table",
    "data table"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dagda1/material-react-table"
  },
  "homepage": "https://github.com/dagda1/material-react-table#readme",
  "bugs": {
    "url": "https://github.com/dagda1/material-react-table/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "locales",
    "src"
  ],
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "65 KB"
    }
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm lib:build",
    "build-locales": "pnpm lib:build-locales",
    "build-lib": "pnpm lib:build-lib",
    "dev": "pnpm lib:dev",
    "lib:build": "pnpm build-lib && pnpm build-locales",
    "lib:build-locales": "node build-locales.mjs",
    "lib:build-lib": "tsdown && size-limit",
    "lib:dev": "tsdown --watch",
    "lint": "oxlint . --fix --deny-warnings && oxfmt .",
    "size": "size-limit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm lib:build && pnpm test",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "storybook:build": "storybook build",
    "storybook:dev": "storybook dev -p 6006 --host 127.0.0.1",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@cutting/useful-types": "4.46.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@faker-js/faker": "^10.6.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-date-pickers": "^9.16.0",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-links": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dayjs": "^1.11.23",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "rolldown": "^1.2.15",
    "size-limit": "^14.3.0",
    "storybook": "^10.6.5",
    "storybook-dark-mode": "^5.0.0",
    "tsdown": "^0.23.3",
    "tslib": "^2.8.1",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@emotion/react": ">=11.13",
    "@emotion/styled": ">=11.13",
    "@mui/icons-material": ">=9",
    "@mui/material": ">=9",
    "@mui/x-date-pickers": ">=9.2",
    "react": ">=19.0",
    "react-dom": ">=19.0"
  },
  "dependencies": {
    "@tanstack/match-sorter-utils": "9.2.6",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.23",
    "@tanstack/table-core": "9.3.1",
    "highlight-words": "2.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locales/*": {
      "types": "./locales/*/index.d.mts",
      "default": "./locales/*/index.mjs"
    },
    "./package.json": "./package.json"
  }
}
