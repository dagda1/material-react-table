{
  "version": "4.1.0",
  "license": "MIT",
  "name": "@cutting/material-react-table",
  "description": "Maintenance fork of material-react-table updated for Material UI v9. A fully featured Material UI implementation of TanStack React Table V8.",
  "author": "Paul Cowan <paul.cowan@cutting.scot>",
  "contributors": [
    {
      "name": "Kevin Vandy",
      "url": "https://github.com/KevinVandy"
    }
  ],
  "keywords": [
    "react-table",
    "material-ui",
    "material-table",
    "tanstack table",
    "data table"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dagda1/material-react-table"
  },
  "homepage": "https://github.com/dagda1/material-react-table#readme",
  "bugs": {
    "url": "https://github.com/dagda1/material-react-table/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "locales",
    "src"
  ],
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "56 KB"
    },
    {
      "path": "dist/index.mjs",
      "limit": "53 KB"
    }
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm lib:build",
    "build-locales": "pnpm lib:build-locales",
    "build-lib": "pnpm lib:build-lib",
    "dev": "pnpm lib:dev",
    "lib:build": "pnpm build-lib && pnpm build-locales",
    "lib:build-locales": "node build-locales.mjs",
    "lib:build-lib": "tsdown && size-limit",
    "lib:dev": "tsdown --watch",
    "lint": "eslint .",
    "size": "size-limit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm lib:build && pnpm test",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:dev": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/x-date-pickers": "^9.12.0",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-links": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.0",
    "dayjs": "^1.11.23",
    "eslint": "^10.9.1",
    "eslint-plugin-mui-path-imports": "^0.0.15",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-storybook": "^10.5.10",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "rolldown": "^1.2.6",
    "size-limit": "^13.0.3",
    "storybook": "^10.5.10",
    "storybook-dark-mode": "^5.0.0",
    "tsdown": "^0.22.14",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@emotion/react": ">=11.13",
    "@emotion/styled": ">=11.13",
    "@mui/icons-material": ">=9",
    "@mui/material": ">=9",
    "@mui/x-date-pickers": ">=9.2",
    "react": ">=19.0",
    "react-dom": ">=19.0"
  },
  "dependencies": {
    "@tanstack/match-sorter-utils": "9.1.2",
    "@tanstack/react-table": "9.1.2",
    "@tanstack/react-virtual": "3.14.10",
    "@tanstack/table-core": "9.1.2",
    "highlight-words": "2.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./locales/*": {
      "import": {
        "types": "./locales/*/index.d.mts",
        "default": "./locales/*/index.mjs"
      },
      "require": {
        "types": "./locales/*/index.d.ts",
        "default": "./locales/*/index.js"
      }
    },
    "./package.json": "./package.json"
  }
}
